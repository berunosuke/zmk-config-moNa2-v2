#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100 
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&kp TAB>, <&kt LALT>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 3 Q           &kp LS(NUMBER_3)  &kp U                 &kp DQT      &kp LS(INT_RO)                                     &kp F          &kp W  &kp R  &kp Y    &lt 3 P
&kp E             &kp I             &kp A                 &kp O        &mt PERIOD COMMA                        &kp MINUS  &kp K          &kp T  &kp N  &kp S    &lt 2 H
&kp LEFT_CONTROL  &kp X             &kp C                 &kp V        &kp L               &kp LEFT            &kp RIGHT  &kp G          &kp D  &kp M  &ht J Z  &kp B
&kp LEFT_ALT      &kp LEFT_WIN      &mt LEFT_SHIFT SLASH  &lt 1 SPACE  &lt 2 INT_MUHENKAN  &lt 3 INT_HENKAN    &kp ENTER  &kp BACKSPACE                           &mkp MB4
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3       &kp NUMBER_4      &kp NUMBER_5                                                  &kp NUMBER_6       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)   &kp LS(NUMBER_4)  &kp LS(N5)                         &kp RIGHT_BRACKET  &kp SLASH          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT
&kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N8)         &kp LS(N9)        &kp LEFT_BRACKET  &kp SEMI         &kp RIGHT_BRACE    &kp LS(BACKSLASH)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOUBLE_QUOTES
&trans            &kp INT_MUHENKAN  &kp INTERNATIONAL_4  &trans          &trans            &trans           &trans             &trans                                                                       &kp N4
            >;
            sensor-bindings = <&scroll_right_left &scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp B   &kp B   &kp W   &kp B   &kp C                               &kp CARET  &kp AMPERSAND  &kp UP_ARROW    &kp DOWN_ARROW  &kp UNDERSCORE
&kp C   &kp A   &kp S   &kp D   &trans             &trans   &mkp MB3   &mkp MB1   &mkp MB1       &mkp MB2        &kp PLUS
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F11    &kp F12  &kp F6     &kp F7     &kp F8         &kp F9          &kp F10
&trans  &trans  &trans  &trans  &trans  &trans     &trans   &trans                                                               &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &kp LC(LS(TAB))        &kp LC(TAB)      &kp PRINTSCREEN  &trans                                         &kp HOME  &kp END            &kp LEFT_SHIFT  &kp UP_ARROW         &trans
&trans  &kp LG(C_VOLUME_DOWN)  &kp C_VOLUME_UP  &kp K_MUTE       &kp LC(LG(RIGHT_ARROW))             &trans  &trans    &kp LC(BACKSPACE)  &kp LC(LEFT)    &kp LC(RIGHT_ARROW)  &trans
&trans  &kp C_PP               &kp C_NEXT       &kp LA(TAB)      &trans                   &trans    &trans  &trans    &kp DELETE         &kp PAGE_UP     &kp PAGE_DOWN        &trans
&trans  &trans                 &trans           &trans           &mkp MB1                 &mkp MB2  &trans  &trans                                                                    &trans
            >;
            // 左側: ウィンドウ切り替え / 右側: 形式合わせのためのダミー(実体はoverlay側で制御)
            sensor-bindings = <&inc_dec_kp LA(TAB) LS(LA(TAB)) &scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                                    &bt BT_CLR_ALL
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &mkp MB5                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                &trans  &trans  &mkp MB1  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2    &trans  &trans                                  &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };
    };
};
