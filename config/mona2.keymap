#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// GUIツールでは自動削除されてしまう、スクロール機能の必須設定を復元
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>; // スクロール信号の安定化
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>; // スクロール信号の安定化
        };
    };

    macros {
        kakezan: kakezan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp COMMA &kp X>;
        };

        MB1_INT4_to0: MB1_INT4_to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // クリック判定と文字変換の間に僅かな猶予(30ms)を持たせ、OSの処理落ちによる不発を防ぐ
            wait-ms = <30>; 
            tap-ms = <30>;
            bindings = <&mkp MB1>, <&kp INT4>, <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 3 INT4        &kp LS(INT_RO)    &kp U                 &kp L        &kp INT1                                     &kp F          &kp W  &kp R  &kp Y    &lt 3 P
&kp E             &kp I             &kp A                 &kp O        &mt PERIOD COMMA                        &kp MINUS  &kp K          &kp T  &kp N  &kp S    &lt 2 H
&kp EQUAL         &kp X             &kp C                 &kp V        &kp Q               &kp LEFT            &kp RIGHT  &kp G          &kp D  &kp M  &ht J Z  &kp B
&kp LALT          &kp LGUI          &mt LSHIFT SLASH      &lt 1 INT5   &mkp MB1            &mkp MB2            &kp ENTER  &kp BACKSPACE                           &tog 2
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp N1            &kp N2            &kp N3             &kp N4            &kp N5                                                  &kp N6             &kp N7        &kp N8        &kp N9           &kp N0
&kp LS(N1)        &kp SQT           &kp LS(N3)         &kp LBKT          &kp LS(N7)                         &kp INT1             &kp EQUAL          &kp LS(N8)    &kp RBKT      &kp LS(RBKT)     &mt MINUS LS(SEMI)
&kp LS(SLASH)     &kp LS(N4)        &kp LS(N5)         &kp LS(N6)        &kp LS(N2)        &kp LS(SQT)      &kp LS(INT3)         &kp INT3           &kp LS(N9)    &kp INT_RO    &kp LS(INT_RO)   &kakezan
&trans            &kp LANG5         &trans             &trans            &trans            &trans           &trans               &trans                                                          &kp LS(MINUS)
            >;
            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                 &trans    &trans    &trans    &mkp MB3       &to 0
&trans  &trans  &trans  &trans  &trans            &trans       &trans  &mkp MB5  &mkp MB1  &MB1_INT4_to0  &mkp MB2  &mkp MB4
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans    &trans    &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                     &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &kp LS(TAB)  &kp TAB      &kp LC(TAB)  &kp PSCRN                                      &kp HOME  &kp END   &kp UP    &kp PAGE_UP   &trans
&trans  &kp C_VOL_DN &kp C_VOL_UP &kp K_MUTE   &kp C_NEXT           &trans   &trans           &trans    &trans    &kp LC(BSPC)  &kp LEFT &kp DOWN &kp RIGHT
&kp F1  &kp F2       &kp F3       &kp F4       &kp F5     &kp F11   &kp F12  &kp F6           &kp F7    &kp F8    &kp F9    &kp F10
&trans  &trans       &trans       &trans       &trans     &trans    &trans   &trans                                         &trans
            >;
            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                                    &bt BT_CLR_ALL
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};
